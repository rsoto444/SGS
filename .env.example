# Copy this file to .env and fill in what you have. Commands tell you when one is needed.
# .env is gitignored. Never commit it, never paste a key into a chat or a page.

# Pexels - /build-website's stock photos when you have no real photos yet.
# Free, no card: pexels.com/api. Falls back to Openverse without it.
PEXELS_API_KEY=

# /enrich-contacts - only fill in the providers you actually have. Skipped if blank.
APOLLO_API_KEY=
LUSHA_API_KEY=
# Clay: table webhook URL (Clay > your table > Add > Webhook)
CLAY_WEBHOOK_URL=

# Where the contact + quote forms post. Any webhook works (GoHighLevel, Make, Zapier, n8n).
# GHL: Automation > Workflows > Inbound Webhook. Until this is set, the forms error.
LEAD_WEBHOOK_URL=
